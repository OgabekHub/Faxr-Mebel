# Server-only Telegram credentials. Never prefix these with VITE_ :
# anything that starts with VITE_ is compiled into the public browser bundle.
TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-BotFather
TELEGRAM_CHAT_ID=-1001234567890

# Comma-separated list of origins allowed to call /api/notify.
# Leave empty to skip the origin check.
ALLOWED_ORIGINS=https://faxr-mebel.vercel.app,http://localhost:5173

# Public site URL, used to build AR QR-code links (safe to expose).
VITE_APP_URL=https://faxr-mebel.vercel.app
